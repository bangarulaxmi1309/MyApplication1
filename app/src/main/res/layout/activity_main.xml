<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FDF4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Title -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌿 AirCare"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#166534"
            android:gravity="center"
            android:padding="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Air Quality Monitoring"
            android:textSize="16sp"
            android:textColor="#555555"
            android:gravity="center"
            android:paddingBottom="20dp"/>

        <!-- Location -->

        <TextView
            android:id="@+id/txtLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Detecting Location..."
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#166534"
            android:gravity="center"
            android:padding="12dp"/>

        <!-- AQI Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:gravity="center"
            android:padding="25dp"
            android:elevation="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Air Quality Index"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#166534"/>

            <TextView
                android:id="@+id/txtAQI"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="65sp"
                android:textStyle="bold"
                android:textColor="#16A34A"
                android:padding="15dp"/>

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waiting for Data"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#16A34A"/>

            <TextView
                android:id="@+id/txtUpdated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last updated: --"
                android:textSize="13sp"
                android:textColor="#777777"
                android:padding="10dp"/>

            <Button
                android:id="@+id/btnRefresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Refresh AQI"
                android:backgroundTint="#15803D"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- Pollutants -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Air Pollutant Details"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#166534"
            android:paddingTop="25dp"
            android:paddingBottom="12dp"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <TextView
                android:id="@+id/txtPM25"
                style="@style/PollutantText"
                android:text="PM2.5: --"/>

            <TextView
                android:id="@+id/txtPM10"
                style="@style/PollutantText"
                android:text="PM10: --"/>

            <TextView
                android:id="@+id/txtCO"
                style="@style/PollutantText"
                android:text="CO: --"/>

            <TextView
                android:id="@+id/txtNO2"
                style="@style/PollutantText"
                android:text="NO2: --"/>

            <TextView
                android:id="@+id/txtSO2"
                style="@style/PollutantText"
                android:text="SO2: --"/>

            <TextView
                android:id="@+id/txtO3"
                style="@style/PollutantText"
                android:text="O3: --"/>

        </GridLayout>

        <!-- Health Advice -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="❤️ Health Recommendations"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#166534"
            android:paddingTop="25dp"/>

        <TextView
            android:id="@+id/txtHealthAdvice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Health advice will appear here based on AQI."
            android:textSize="16sp"
            android:textColor="#333333"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginTop="12dp"
            android:elevation="3dp"/>

        <!-- History Button -->

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Previous Readings"
            android:layout_marginTop="20dp"
            android:backgroundTint="#15803D"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</ScrollView>
